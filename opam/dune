(rule
 (target stere.%{version:stere}.opam)
 (deps
  (:opam ../stere.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run
     git
     log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/stere#%H\" }"
     -n1)))))

(rule
 (target stere-ios.opam)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{target}
   (run
    %{workspace_root}/.logistic/ci/dune/dune_sak.exe
    rewrite-ios
    --input
    %{dep:../stere.opam}
    --cross
    stere,stere-otel,fmt,logs,lwt,opentelemetry
    --cross-both
    ""
    --cross-exclude
    ""))))


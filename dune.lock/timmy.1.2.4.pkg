(version 1.2.4)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune base fmt ocaml ppx_here ppx_deriving ptime schematic)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/timmy#757200857b68689a306d8af0adfce93335aace80)))

(dev)
